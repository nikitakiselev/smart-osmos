/**
 * Параметры удалённого HTTPS-сервера (не коммитить в git).
 * Скопируйте как server_secrets.h и заполните.
 */

#ifndef SERVER_SECRETS_H
#define SERVER_SECRETS_H

/** Хост сервера (IP или домен) */
#define SERVER_HOST        "192.168.1.100"

/** Порт HTTPS (обычно 443 или 8443) */
#define SERVER_PORT        8443

/** Путь для приёма телеметрии (POST JSON) */
#define SERVER_PATH        "/api/ingest"

/** Секретный API-ключ (должен совпадать с ключом на сервере) */
#define SERVER_API_KEY     "your-secret-api-key"

#endif // SERVER_SECRETS_H
